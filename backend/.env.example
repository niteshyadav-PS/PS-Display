# --- Core ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ps-display

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- App URLs ---
CLIENT_URL=http://localhost:5173
DISPLAY_PLAYER_URL=http://localhost:5174
# Absolute base used when building upload URLs behind a proxy (optional)
PUBLIC_API_URL=

# Comma-separated browser origins allowed to call the API.
# Leave blank to fall back to CLIENT_URL + DISPLAY_PLAYER_URL.
# In development, private LAN IPs (e.g. http://192.168.x.x:5174) are also allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# For Android TV / other devices on your Wi‑Fi:
# 1. Run npm run dev from the repo root (api + admin + player)
# 2. Vite/API listen on 0.0.0.0 so http://<YOUR-PC-IP>:5174 works
# 3. Open that URL on the TV (not localhost)

# --- Limits ---
MAX_UPLOAD_MB=50
MAX_PROXY_MB=25
# A display counts as offline if it has not polled within this many seconds
DISPLAY_OFFLINE_AFTER_SEC=90

# --- Seed (optional) ---
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=password123

# --- Google OAuth (required for personal Gmail calendars) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# --- Optional Google service account (Workspace only) ---
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE=false

# --- Microsoft (optional) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
